# Copy to backend/.env and fill in. Never commit backend/.env.

# --- MySQL (read-only account; see README "MySQL setup") ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=jev_reader
MYSQL_PASSWORD=
MYSQL_DATABASE=fast_jev_test

# --- JEV provider (backend only; never exposed to the frontend) ---
# "openrouter" (OpenRouter Decisions API) or "cloudflare" (Workers AI)
JEV_PROVIDER=openrouter

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_JEV_MODEL=~typesafe/jev-latest

# Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
JEV_MODEL=typesafe/jev
# Development only. Returns obviously synthetic answers, labelled MOCK in the UI.
JEV_MOCK_MODE=false
# Optional tuning (defaults shown)
# JEV_TIMEOUT_SECONDS=20
# JEV_MAX_RETRIES=2
# JEV_LOW_CONFIDENCE_THRESHOLD=0.5
# JEV_INCLUDE_SAMPLE_VALUES=false
# CANDIDATE_MAX_FIELDS=25

# --- App ---
FRONTEND_URL=http://localhost:5173
# LOG_CAMPAIGN_TEXT=true
# DEBUG_ERRORS=false
